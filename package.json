{
  "name": "bambudeck",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "bun --watch server/index.ts",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "bun server/index.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "check": "bun run fmt:check && bun run lint",
    "prepare": "bun scripts/prepare.ts",
    "commitlint": "commitlint",
    "release": "bun scripts/release.ts",
    "release:notes": "bun scripts/release-notes.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/space-grotesk": "^5.2.0",
    "archiver": "^7.0.1",
    "basic-ftp": "^5.0.5",
    "better-auth": "^1.7.7",
    "busboy": "^1.6.0",
    "elysia": "^1.4.0",
    "fast-xml-parser": "^5.3.0",
    "lucide-vue-next": "^0.468.0",
    "mqtt": "^5.14.0",
    "three": "^0.186.1",
    "vue": "^3.5.0",
    "yauzl": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/archiver": "^6.0.3",
    "@types/bun": "^1.3.0",
    "@types/busboy": "^1.5.4",
    "@types/three": "^0.186.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "changelogen": "^0.6.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.0.0"
  }
}
