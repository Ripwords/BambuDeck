{
  "name": "bambudeck",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "bun --watch server/index.ts",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "bun server/index.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/space-grotesk": "^5.2.0",
    "elysia": "^1.4.0",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.0",
    "mqtt": "^5.14.0",
    "basic-ftp": "^5.0.5",
    "yauzl": "^3.2.0",
    "fast-xml-parser": "^5.3.0",
    "archiver": "^7.0.1",
    "busboy": "^1.6.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/bun": "^1.3.0",
    "@types/busboy": "^1.5.4",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.0.0"
  }
}
