{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "vue"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-control-regex": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "docs/.vitepress/cache/**",
    "docs/.vitepress/dist/**",
    ".cache/**",
    ".husky/_/**"
  ]
}
